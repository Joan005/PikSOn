[config]
font=JetBrainsMono Nerd Font 12
background-color=#1e1e2eee
text-color=#cdd6f4
border-color=#cba6f7
progress-color=over #313244
border-size=2
border-radius=12
padding=12
margin=10
width=360
height=120
anchor=top-right
layer=overlay
default-timeout=5000
ignore-timeout=0
max-visible=5
sort=-time

[urgency=low]
border-color=#89b4fa
default-timeout=3000

[urgency=normal]
border-color=#cba6f7
default-timeout=5000

[urgency=high]
border-color=#f38ba8
background-color=#1e1e2eee
default-timeout=0
