[
{
    "layer": "top",
    "position": "top",
    "height": 46,
    "spacing": 6,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": ["custom/power", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["custom/whisper", "clock", "mpris", "wireplumber"],
    "modules-right": ["battery"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "󰲠",
            "2": "󰲢",
            "3": "󰲤",
            "4": "󰲦",
            "5": "󰲨",
            "active": "󰮯",
            "default": "󰊠"
        },
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        },
        "on-click": "activate",
        "sort-by-number": true
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true
    },

    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%A, %d de %B de %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-paused": "⏸  {dynamic}",
        "player-icons": {
            "spotify": "",
            "default": "▶"
        },
        "dynamic-len": 35,
        "dynamic-order": ["title", "artist"],
        "player": "spotify",
        "on-click": "~/.config/waybar/scripts/spotify-popup.sh",
        "on-click-right": "playerctl next --player=spotify",
        "on-click-middle": "playerctl previous --player=spotify",
        "tooltip": false
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "pwvucontrol",
        "scroll-step": 5
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "tray": {
        "spacing": 8
    },

    "custom/whisper": {
        "exec": "[ -f /tmp/whisper_record.pid ] && echo ' REC' || echo ''",
        "interval": 1,
        "format": "{}",
        "on-click": "~/.config/hypr/scripts/whisper-toggle.sh"
    },

    "custom/power": {
        "format": "󰐥",
        "on-click": "~/.config/waybar/scripts/power.sh",
        "tooltip": false
    }
},

{
    "output": "DP-1",
    "layer": "top",
    "position": "right",
    "width": 75,
    "margin-top": 62,
    "margin-bottom": 8,
    "margin-right": 8,

    "modules-left": [],
    "modules-center": [],
    "modules-right": ["tray"],

    "tray": {
        "icon-size": 20,
        "spacing": 6,
        "show-passive-items": true
    }
}
]
